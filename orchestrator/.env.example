# Copy this file to ".env" in the same folder and adjust as needed.
# .env should NOT be committed to GitHub (already covered by .gitignore).

ENV=development

# Point these at teammates' real services once they exist.
# Until then, they point at the mock servers you run locally for testing.
QUERY_AGENT_URL=http://localhost:8001
RETRIEVAL_AGENT_URL=http://localhost:8002
REVIEW_AGENT_URL=http://localhost:8003

# Security
API_KEY=foodwise-dev-key-change-me
RATE_LIMIT_PER_MINUTE=30

REQUEST_TIMEOUT_SECONDS=8.0
